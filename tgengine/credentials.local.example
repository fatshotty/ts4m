# Built-in Telegram API credentials, baked into the engine at build time.
#
# Copy this file to `credentials.local` (git-ignored) and fill in your own values
# from https://my.telegram.org. build-aar.sh sources it, XOR+base64-obfuscates the
# values, and injects them into the .so via -ldflags. Leave `credentials.local`
# absent to ship without defaults (the app then asks each user for their own).
API_ID=0
API_HASH=
